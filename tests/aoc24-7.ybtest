import aoc
import parse
import math
import text

fun ~calc(total: int, acc: int) = {
  case
  | if /$/, let return = when?(total == acc) then total
  | if / /, n: if text.num
    case
    | return: if calc(total, acc + n)
    | return: if calc(total, acc * n)
    | return: if calc(total, acc * math.ipow(10, span n.sizeof) + n)
  \ \
}

export
fun ~test = aoc.summap(text.line |> {
  total: if text.num, if >": ", first: if text.num
  return: alt(calc(total, first), pure(0))
})

