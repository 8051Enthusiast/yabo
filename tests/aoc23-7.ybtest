====[ source code ]====
import text
import aoc

fun ~match(f: int) = {
  r: ~, let return = when?(f == r) then 1 else 0
}

fun ~match_count(f: int, len: int) = [len]match(f) |> aoc.summap(~ is !eof)

fun ~same_count = {
  case
  | f: ~, count: if match_count(f, 4) is 2..4, let return = count + 1
  | ~, f: ~, count: if match_count(f, 3) is 2..3, let return = count + 1
  | ~, ~, f: ~, count: if match_count(f, 2) is 2, let return = 3
  | let return = 2
  \
}

fun ~charbit = {
  c: ~, let return = 1 << (c - '0')
}

fun ~diff_count: int = {
  a: charbit, b: charbit, c: charbit, d: charbit, e: charbit
  let return = ∑(a | b | c | d | e)
}

fun ~card_rank = {
  card: ~
  case
  | let return = card if 0x32..0x39 - 0x32
  | let return = card if 0x54 then 8
  | let return = card if 0x4a then 9
  | let return = card if 0x51 then 10
  | let return = card if 0x4b then 11
  | let return = card expect 0x41 then 12
  \
}

fun ~hand_rank = {
  ranks: [5]card_rank
  let return = ranks.[0] << 16 | ranks.[1] << 12 | ranks.[2] << 8 | ranks.[3] << 4 | ranks.[4]
}

fun rank(cards: []u8) = (
  let card_rank = cards ~> hand_rank
  let diff = cards ~> diff_count
  let same = cards ~> same_count
  case
  | let ty = same if 4..5 then (same + 1)
  | let ty = diff if 2 then 4
  | let ty = same if 3 then 3
  | let ty = same expect 2 then (5 - diff)
  \
  ty << 20 | card_rank
)

fun ~play = {
  cards: [5], ~
  bet: expect text.num, ~
  let score = rank(cards)
}

fun ~higher_count(score: int) = aoc.summap({
  p: if play is !eof
  let return = when?(score >= p.score) then 1 else 0
})

fun ~total_win(input: []u8) = aoc.summap({
  p: if play is !eof
  let return = (input ~> higher_count(p.score)) * p.bet
})

export
fun ~test = {
  input: if /.*/
  let return = (input ~> total_win(input))
}

