====[ source code ]====
import text
import parse
import math

def token[T](f: ~T) = {
  expect / */
  return: if f
}

def nud = {
  case
  | if token(/-/)
    n: expect expr(2)
    let return = -n
  | if token(/\+/)
    return: expect expr(2)
  | if token(/\(/)
    return: expect expr(0)
    expect token(/\)/)
  | return: if token(text.num)
  \
}

def led(min_prec: int, lhs: int) = {
  case
  | let op = <op_prec, op_char> {
      if when?(op_prec >= min_prec) then token(parse.byteval(op_char))
    }

    case
    | if op(0, '+')
      rhs: expect expr(1)
      let res = lhs + rhs
    | if op(0, '-')
      rhs: expect expr(1)
      let res = lhs - rhs
    | if op(1, '*')
      rhs: expect expr(2)
      let res = lhs * rhs
    | if op(2, '^')
      rhs: expect expr(2)
      let res = math.ipow(lhs, rhs)
    \
    return: led(min_prec, res)
  | let return = lhs
  \
}

def expr(min_prec: int) = {
  lhs: if nud
  return: led(min_prec, lhs)
}

export
def test = {
  return: expect expr(0)
  expect token(text.line_end)
}

====[ text 1 ]====
1+2*3
====[ output 1 ]====
7

====[ text 2 ]====
