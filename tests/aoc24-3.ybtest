====[ source code ]====
import parse
import text
import aoc

fun ~dont = {
  if >"don't()"
  expect parse.find(alt(parse.eof, {if >"do()"}))
  let return = 0
}

fun ~mul = {
  if >"mul(", a: if text.num, if >",", b: if text.num, if >")"
  let return = a * b
}

export
fun ~test = aoc.summap(parse.find(alt(mul is !eof, dont is !eof)))

====[ text 1 ]====
xmul(2,4)&mul[3,7]!^don't()_mul(5,5)+mul(32,64](mul(11,8)undo()?mul(8,5))

