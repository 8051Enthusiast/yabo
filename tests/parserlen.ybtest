====[ source code ]====
def g[A, B](a: ~A, b: ~B) = {
  case
  | if a, if b, if a
  | if b, if a, if a
  \
}
def square(n: int) = [n * n]
def poly_unify(n: int, m: int) = {
  case
  | [2 * n * m - 1]
    [n * n]
    [m * m]
    ~
  | square(n + m)
    poly_unify(0, 0)
  \
}
def static_len(a: int) = {
  case
  | [a], [a]
  | [2 * a]
  \
  [a & 43]
}
export def test = {
  let a: ~_ = {}
  let a_len = a.sizeof
  let b: ~_ = ~
  let b_len = b.sizeof
  let c: ~_ = { d, b, b }
  let c_len = c.sizeof
  let d: ~_ = [10]
  let d_len = d.sizeof
  let e: ~_ = g([10], ~)
  let e_len = e.sizeof
  let h: ~_ = poly_unify(4, 3)
  let h_len = h.sizeof
  let k: ~_ = static_len(31)
  let k_len = k.sizeof
}

