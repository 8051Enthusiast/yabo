====[ source code ]====
fun ev_10[T](g: (int) -> T) = g(10)
fun ev_20[T](g: (int) -> T) = g(20)

export
fun ~test = {
  x: ~
  let f = <n> x if 0 then (<m> n - m) else (<m> n + m)
  let g = <n> <m> n * m
  let h = x if 0 or 1 then f else g
  let return = ev_10(ev_20(h))
}

====[ binary 1 ]====
00

====[ output 1 ]====
10

