====[ source code ]====
fun table[T](f: (int) -> T) = 0..<2 ~> map(f)

fun get_table(x: bit) = x if true then (
    table(<c> c if 1 then (<t> t + 1) else (<t> t - 1))
  ) else (
    table(<c> <t> c if 1 then t * 2 else t / 2)
  )

export
fun ~test = {
  x: ~
  y: ~
  let tab = get_table(x != 0)
  let return = tab ~> map(<f> f!(y))
}

====[ binary 1 ]====
01 04

====[ output 1 ]====
[3, 5]

====[ binary 2 ]====
00 04

====[ output 2 ]====
[2, 8]
